# D:\42_asia-hackathon\.env

# 1. LLM 설정 (가장 중요)
# 🔴 [수정] .gguf 확장자를 제거하여 'llm-server'의 모델 별칭과 일치시킵니다.
# LLM_MODEL_NAME=google_gemma-3-4b-it-Q4_K_M
LLM_MODEL_NAME=Qwen2.5-7b-Chat-Q4_K_M

# 2. 데이터베이스 및 브로커 (docker-compose 내부 이름)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
MEILI_URL=http://meilisearch:7700

# 🔴 [수정] /v1 경로가 포함되어 있는지 확인합니다.
LLM_API_BASE_URL=http://llm-server:11435/v1
MEILI_MASTER_KEY="SuperSecure_42Asia_MasterKey"

# 4. 타임아웃 (기본값)
LLM_TIMEOUT=300